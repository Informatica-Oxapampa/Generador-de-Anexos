<!--
    Views/PaginaTdr.xaml
    ────────────────────
    Formulario de Términos de Referencia.

    Orden de tarjetas: importar Pedido SIGA, Datos Generales, Objeto de la
    Contratación, Características del Servicio, Requisitos del Locador,
    Entregables y Forma de Pago; con la barra de acciones fija al pie.

    Todas las tarjetas comparten la misma métrica (relleno 20, radio 8,
    separación 16) para que la página tenga un ritmo vertical uniforme.
-->
<UserControl
    x:Class="GeneradorAnexos.WinUI.Views.PaginaTdr"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeneradorAnexos.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Desplazador" Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
            <!-- El contenido se estira siempre al ancho disponible.

                 NO poner aqui MaxWidth ni HorizontalAlignment:
                   - HorizontalAlignment="Left" hace que el panel adopte el
                     ancho natural de su contenido y deje hueco a la derecha.
                   - MaxWidth, al maximizar la ventana, deja espacio sobrante y
                     el bloque se descoloca hacia la derecha y se recorta.
                 El ancho lo marca la ventana, y punto. -->
            <StackPanel Padding="24,4,24,24" Spacing="16">

                <!-- ══════ Importar Pedido de Servicio (SIGA) ══════ -->
                <controls:TarjetaSeccion
                    Titulo="Importar desde Pedido de Servicio (SIGA)"
                    Descripcion="Cargue el PDF original del SIGA para autocompletar dirección solicitante, motivo, meta, clasificador, valor y unidad de medida."
                    Icono="folder">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource Ga.BotonSecundario}"
                                Click="AlCargarPedido"
                                ToolTipService.ToolTip="Elegir el archivo PDF del pedido">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:Icono Nombre="folder" Tamano="15" />
                                <TextBlock Text="Cargar pedido" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Grid.Column="1"
                                Background="{ThemeResource Ga.PanelAlterno}"
                                BorderBrush="{ThemeResource Ga.PanelBorde}"
                                BorderThickness="1"
                                CornerRadius="4"
                                MinHeight="34"
                                Padding="12,6,12,6">
                            <TextBlock x:Name="ArchivoPedido"
                                       Text="Ningún archivo seleccionado"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource Ga.TextoTenue}" />
                        </Border>

                        <Button x:Name="BotonProcesar" Grid.Column="2"
                                Style="{StaticResource Ga.BotonPrimario}"
                                IsEnabled="False"
                                Click="AlProcesarPedido"
                                ToolTipService.ToolTip="Leer el PDF y completar el formulario">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:Icono Nombre="check" Tamano="15"
                                                Trazo="{ThemeResource Ga.SobreAcento}" />
                                <TextBlock Text="Procesar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </controls:TarjetaSeccion>

                <!-- ══════════ Datos Generales ══════════ -->
                <controls:TarjetaSeccion Titulo="Datos Generales"
                                         Descripcion="Área usuaria y datos presupuestales de la contratación."
                                         Icono="building">
                    <StackPanel Spacing="14">
                        <controls:CampoCombo x:Name="CampoOficina"
                                             Titulo="Dirección Solicitante (Área usuaria)"
                                             Marcador="Busque por gerencia, oficina o subgerencia…"
                                             Ayuda="Área usuaria que solicita la contratación. En los documentos se usa como Centro de costo y Área usuaria."
                                             MensajeError="Ingrese o seleccione la dirección solicitante."
                                             Editable="True"
                                             Icono="building" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:CampoTexto x:Name="CampoPedido" Grid.Column="0"
                                                 Titulo="N° de pedido"
                                                 Marcador="Ej.: 001211 o 000123-A"
                                                 Icono="id"
                                                 MensajeError="Ingrese el N° de pedido." />
                            <controls:CampoTexto x:Name="CampoActividad" Grid.Column="1"
                                                 Titulo="Actividad POI / Acción estratégica PEI"
                                                 Marcador="Ej.: Gestión administrativa"
                                                 Icono="text"
                                                 MensajeError="Ingrese la actividad POI." />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:CampoTexto x:Name="CampoFuente" Grid.Column="0"
                                                 Titulo="Fuente de financiamiento"
                                                 Marcador="Ej.: Recursos Ordinarios"
                                                 Icono="bank"
                                                 MensajeError="Ingrese la fuente de financiamiento." />
                            <controls:CampoTexto x:Name="CampoMeta" Grid.Column="1"
                                                 Titulo="Meta"
                                                 Marcador="Ej.: 0001"
                                                 Icono="receipt"
                                                 MensajeError="Ingrese la meta." />
                        </Grid>

                        <controls:CampoTexto x:Name="CampoClasificador"
                                             Titulo="Clasificador de gasto"
                                             Marcador="Ej.: 2.3.2.7.11.99"
                                             Icono="card"
                                             MensajeError="Formato no válido (ej.: 2.3.2.7.11.99)." />

                        <controls:CampoArea x:Name="CampoDenominacion"
                                            Titulo="Denominación del servicio"
                                            Marcador="Nombre del servicio a contratar…"
                                            Ayuda="Se usa como objeto y descripción del servicio (cuadro) y se sincroniza con la sección Anexos."
                                            Altura="104" />
                    </StackPanel>
                </controls:TarjetaSeccion>

                <!-- ══════════ Objeto de la Contratación ══════════ -->
                <controls:TarjetaSeccion Titulo="Objeto de la Contratación"
                                         Descripcion="Objeto, finalidad pública y cuadro del objeto del servicio."
                                         Icono="receipt">
                    <StackPanel Spacing="14">
                        <controls:CampoArea x:Name="CampoObjetivo"
                                            Titulo="Objeto de la contratación"
                                            Marcador="Objeto de la contratación…"
                                            Ayuda="Se completa con la denominación; puede editarlo si necesita un texto distinto."
                                            Altura="72" />
                        <controls:CampoArea x:Name="CampoFinalidad"
                                            Titulo="Finalidad pública"
                                            Marcador="Descripción de la finalidad pública…"
                                            Altura="80" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="Cuadro del objeto del servicio"
                                       Style="{StaticResource Ga.SubtituloCampo}" />
                            <ContentControl x:Name="ContenedorTablaObjeto"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </controls:TarjetaSeccion>

                <!-- ══════════ Características del Servicio ══════════ -->
                <controls:TarjetaSeccion Titulo="Características del Servicio"
                                         Descripcion="Actividades a desarrollar y plazo de prestación."
                                         Icono="clock">
                    <StackPanel Spacing="14">
                        <controls:CampoArea x:Name="CampoActividades"
                                            Titulo="Actividades a desarrollar"
                                            Marcador="Detalle de las actividades a desarrollar…"
                                            Altura="96" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:CampoTexto x:Name="CampoDias"
                                                 Grid.Column="0"
                                                 Titulo="Plazo de prestación (días calendario)"
                                                 Marcador="Plazo máximo del servicio"
                                                 Icono="clock"
                                                 MensajeError="Ingrese un número de días válido." />
                        </Grid>
                    </StackPanel>
                </controls:TarjetaSeccion>

                <!-- ══════════ Requisitos del Locador ══════════ -->
                <controls:TarjetaSeccion Titulo="Requisitos del Locador"
                                         Descripcion="Formación, experiencia, capacitación y requisitos adicionales."
                                         Icono="id">
                    <StackPanel Spacing="16">

                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Requisitos incluidos por defecto"
                                 Message="La plantilla ya incorpora los requisitos base. Si necesita otros, agréguelos en «Requisitos adicionales»." />

                        <Border Style="{StaticResource Ga.PanelRequisitos}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="INCLUIDOS POR DEFECTO EN LA PLANTILLA"
                                           Style="{StaticResource Ga.RotuloTenue}" />
                                <StackPanel x:Name="RequisitosBase" Spacing="8" />

                                <Border Style="{StaticResource Ga.Separador}"
                                        Background="{ThemeResource Ga.RequisitosBorde}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="REQUISITOS ADICIONALES (OPCIONAL)"
                                               Style="{StaticResource Ga.RotuloTenue}" />
                                    <TextBlock Text="Se incluirán como viñetas encima de los requisitos base."
                                               Style="{StaticResource Ga.MensajeAyuda}" />
                                </StackPanel>

                                <controls:EditorVinetas x:Name="ListaRequisitos"
                                                        MostrarTitulo="False"
                                                        MostrarReordenar="False"
                                                        Marcador="Escriba un requisito adicional…"
                                                        TextoBoton="Agregar requisito"
                                                        TextoVacio="Aún no agregó requisitos adicionales." />
                            </StackPanel>
                        </Border>

                        <controls:EditorVinetas x:Name="EditorFormacion"
                                                Titulo="Formación académica"
                                                Marcador="Ej.: Título profesional en … o afines"
                                                TextoBoton="Agregar formación"
                                                TextoVacio="Agregue cada requisito de formación como un elemento." />
                        <controls:EditorVinetas x:Name="EditorExperiencia"
                                                Titulo="Experiencia"
                                                Marcador="Ej.: Experiencia mínima de 2 años en …"
                                                TextoBoton="Agregar experiencia"
                                                TextoVacio="Agregue cada requisito de experiencia como un elemento." />
                        <controls:EditorVinetas x:Name="EditorCapacitaciones"
                                                Titulo="Capacitación y/o programas"
                                                Marcador="Ej.: Capacitación en …"
                                                TextoBoton="Agregar capacitación"
                                                TextoVacio="Agregue cada capacitación como un elemento." />
                    </StackPanel>
                </controls:TarjetaSeccion>

                <!-- ══════════ Entregables ══════════ -->
                <controls:TarjetaSeccion Titulo="Entregables"
                                         Descripcion="Defina uno o varios entregables. La forma de pago se sincroniza automáticamente."
                                         Icono="layers">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Modo de entregables"
                                       Style="{StaticResource Ga.EtiquetaCampo}" />
                            <controls:SelectorModo x:Name="Selector" HorizontalAlignment="Left" />
                        </StackPanel>

                        <ContentControl x:Name="ContenedorUnico"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" />
                        <ContentControl x:Name="ContenedorMultiple"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </controls:TarjetaSeccion>

                <!-- ══════════ Forma de Pago ══════════ -->
                <controls:TarjetaSeccion Titulo="Forma de Pago"
                                         Descripcion="Se genera automáticamente según los entregables."
                                         Icono="dollar">
                    <StackPanel Spacing="14">
                        <Border x:Name="PanelPagoUnico" Style="{StaticResource Ga.PanelInfo}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="ÚNICO PAGO · 100 %" Style="{StaticResource Ga.RotuloPanel}" />
                                <TextBlock Text="A la conformidad otorgada al Único Entregable."
                                           Style="{StaticResource Ga.TextoPanel}" />
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="ContenedorPagoMultiple"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </controls:TarjetaSeccion>
            </StackPanel>
        </ScrollViewer>

        <!-- ══════════ Barra de acciones ══════════ -->
        <Border Grid.Row="1" Style="{StaticResource Ga.BarraAcciones}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="EtiquetaVersion" Grid.Column="0"
                           Style="{StaticResource Ga.VersionPie}"
                           HorizontalAlignment="Left" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource Ga.BotonSecundario}"
                            Click="AlLimpiar"
                            ToolTipService.ToolTip="Borrar los datos del formulario (Ctrl+L)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icono Nombre="eraser" Tamano="15" />
                            <TextBlock Text="Limpiar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Ga.BotonSecundario}"
                            Click="AlVistaPrevia"
                            ToolTipService.ToolTip="Abrir una vista previa en Word (Ctrl+P)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icono Nombre="eye" Tamano="15" />
                            <TextBlock Text="Vista previa" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Ga.BotonPrimario}"
                            Click="AlGenerar"
                            ToolTipService.ToolTip="Generar el documento de TDR">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icono Nombre="file-check" Tamano="15"
                                            Trazo="{ThemeResource Ga.SobreAcento}" />
                            <TextBlock Text="Generar TDR" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
