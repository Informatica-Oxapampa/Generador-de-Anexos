<!--
    Views/PaginaUsuarios.xaml
    ─────────────────────────
    Registros guardados: buscador, contador, lista de tarjetas, estado vacío
    centrado y estado de los respaldos al pie.

    El título de la sección lo muestra la cabecera de la ventana, así que aquí
    no se repite: la página empieza directamente por las herramientas.
-->
<UserControl
    x:Class="GeneradorAnexos.WinUI.Views.PaginaUsuarios"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeneradorAnexos.WinUI.Controls"
    xmlns:viewmodels="using:GeneradorAnexos.WinUI.ViewModels">

    <!-- Sin MaxWidth ni HorizontalAlignment: la lista se estira al ancho de la
         ventana. Ver la nota en PaginaTdr.xaml. -->
    <Grid Padding="24,4,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Buscador y contador -->
        <Grid Grid.Row="0" ColumnSpacing="16" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="Buscador" Grid.Column="0"
                            AutomationProperties.Name="Buscar registros por nombre"
                            MaxWidth="420"
                            MinHeight="34"
                            FontSize="14"
                            HorizontalAlignment="Left"
                            PlaceholderText="Buscar por nombre…"
                            QueryIcon="Find"
                            VerticalAlignment="Center"
                            TextChanged="AlBuscar" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock x:Name="Contador"
                           Style="{StaticResource Ga.RegistroFecha}"
                           VerticalAlignment="Center" />

                <!-- Sustituye a «Guardar como…» del panel lateral: aquí, junto a
                     los registros, se entiende mejor qué hace. -->
                <Button Style="{StaticResource Ga.BotonSecundarioCompacto}"
                        Click="AlGuardarComoNuevo"
                        ToolTipService.ToolTip="Guarda lo que hay ahora en el formulario como un registro nuevo (Ctrl+Mayús+S)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:Icono Nombre="save" Tamano="14" />
                        <TextBlock Text="Guardar como nuevo" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Lista de registros -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
            <StackPanel>
                <ItemsControl x:Name="ListaRegistros">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:RegistroVista">
                            <Border Style="{StaticResource Ga.TarjetaRegistro}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="34" Height="34"
                                            CornerRadius="17"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource Ga.AcentoSuave}"
                                            BorderBrush="{ThemeResource Ga.AcentoBorde}"
                                            BorderThickness="1">
                                        <controls:Icono Nombre="user" Tamano="16"
                                                        Trazo="{ThemeResource Ga.Acento}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Nombre}"
                                                   Style="{StaticResource Ga.RegistroNombre}" />
                                        <TextBlock Text="{x:Bind FechaLegible}"
                                                   Style="{StaticResource Ga.RegistroFecha}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">

                                        <Button Style="{StaticResource Ga.BotonPrimarioCompacto}"
                                                Click="AlCargar"
                                                ToolTipService.ToolTip="Abrir el registro en el formulario">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:Icono Nombre="folder" Tamano="14"
                                                                Trazo="{ThemeResource Ga.SobreAcento}" />
                                                <TextBlock Text="Cargar" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Deshabilitado si el registro no guarda un TDR real -->
                                        <Button Style="{StaticResource Ga.BotonSecundarioCompacto}"
                                                IsEnabled="{x:Bind TieneTdr}"
                                                Click="AlAbrirEnTdr"
                                                ToolTipService.ToolTip="Abrir este registro en la sección de TDR">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:Icono Nombre="clipboard" Tamano="14" />
                                                <TextBlock Text="TDR" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Deshabilitado si el registro no guarda un Anexo real -->
                                        <Button Style="{StaticResource Ga.BotonSecundarioCompacto}"
                                                IsEnabled="{x:Bind TieneAnexo}"
                                                Click="AlAbrirEnAnexos"
                                                ToolTipService.ToolTip="Abrir este registro en la sección de Anexos">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:Icono Nombre="file-check" Tamano="14" />
                                                <TextBlock Text="Anexo" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource Ga.BotonIcono}"
                                                Click="AlDuplicar"
                                                AutomationProperties.Name="Duplicar registro"
                                                ToolTipService.ToolTip="Duplicar: crea una copia con otro nombre">
                                            <controls:Icono Nombre="file" Tamano="15" />
                                        </Button>

                                        <Button Style="{StaticResource Ga.BotonIcono}"
                                                Click="AlRenombrar"
                                                AutomationProperties.Name="Renombrar registro"
                                                ToolTipService.ToolTip="Renombrar">
                                            <controls:Icono Nombre="edit" Tamano="15" />
                                        </Button>

                                        <Button Style="{StaticResource Ga.BotonIconoEliminar}"
                                                Click="AlEliminar"
                                                AutomationProperties.Name="Eliminar registro"
                                                ToolTipService.ToolTip="Eliminar">
                                            <controls:Icono Nombre="trash" Tamano="15" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Estado vacío -->
                <StackPanel x:Name="EstadoVacio"
                            Spacing="14"
                            MinHeight="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="72" Height="72" CornerRadius="36"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource Ga.AcentoSuave}"
                            BorderBrush="{ThemeResource Ga.AcentoBorde}"
                            BorderThickness="1">
                        <controls:Icono Nombre="user" Tamano="30"
                                        Trazo="{ThemeResource Ga.Acento}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Aún no hay registros guardados"
                               Style="{StaticResource Ga.TituloSeccion}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Ga.RegistroFecha}"
                               TextAlignment="Center"
                               MaxWidth="380"
                               Text="Use «Nuevo registro» para asignarle un nombre. Después, «Guardar» actualizará ese mismo registro." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="EstadoRespaldo" Grid.Row="2"
                   Margin="0,14,0,16"
                   Style="{StaticResource Ga.RegistroFecha}" />
    </Grid>
</UserControl>
