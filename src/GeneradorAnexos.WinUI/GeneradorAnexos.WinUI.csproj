<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>GeneradorAnexos.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>

    <!-- Version del producto (Semantic Versioning). Es el unico sitio del
         programa donde se cambia: la aplicacion la lee del ensamblado y el
         instalador comprueba que coincide con la del ejecutable publicado.
         El .iss debe llevar el mismo numero. -->
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Sin empaquetar y autocontenido: produce un .exe que arranca sin
         instalar el runtime de Windows App SDK en el equipo destino. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>

    <AssemblyName>GeneradorAnexos</AssemblyName>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- CS8305 procede del codigo XAML generado por Windows App SDK. Los
         avisos de plataforma y compatibilidad de NuGet no se silencian. -->
    <NoWarn>$(NoWarn);CS8305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK separa las tareas MSIX/PRI en paquetes NuGet, por lo que la
         publicacion funciona tambien con dotnet CLI sin Visual Studio. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
  </ItemGroup>

  <!-- WinAppSDK indexa los XBF embebidos solo por nombre de archivo. El
       Link plano hace coincidir las URI generadas con ese indice. Todos los
       XAML de este ejecutable tienen nombres unicos. -->
  <ItemGroup>
    <Page Update="**\*.xaml">
      <Link>%(Filename)%(Extension)</Link>
    </Page>
    <Page Update="App.xaml">
      <Link>App.xaml</Link>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeneradorAnexos.Domain\GeneradorAnexos.Domain.csproj" />
    <ProjectReference Include="..\GeneradorAnexos.Application\GeneradorAnexos.Application.csproj" />
    <ProjectReference Include="..\GeneradorAnexos.Infrastructure.Windows\GeneradorAnexos.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- version.txt declara la version de plantillas incluida en el instalador;
         el canal de actualizacion de plantillas la compara con la publicada.
         catalogos.json trae las areas usuarias y las entidades bancarias, que
         se actualizan por ese mismo canal sin reinstalar el programa. -->
    <Content Include="..\..\plantillas\**\*.docx;..\..\plantillas\version.txt;..\..\plantillas\catalogos.json"
             Link="plantillas\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- La publicacion por CLI de WinAppSDK puede omitir el indice PRI y
       los XBF propios aunque si esten en TargetDir. Sin ellos el .exe compila,
       pero termina con XamlParseException al crear la ventana principal. -->
  <Target Name="CopiarRecursosWinUiAlPublicar" AfterTargets="Publish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
           Text="No se genero el indice de recursos WinUI $(AssemblyName).pri." />
    <ItemGroup>
      <RecursosWinUiPublicados Include="$(TargetDir)*.xbf" />
      <RecursosWinUiPublicados Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(RecursosWinUiPublicados)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
