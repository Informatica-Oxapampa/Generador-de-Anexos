<!--
    Controls/EditorVinetas.xaml
    ───────────────────────────
    Lista editable de elementos (viñetas del documento o requisitos
    adicionales). Cada fila lleva su viñeta, el cuadro de texto y las acciones.

    Los botones de subir y bajar solo aparecen cuando la lista es ordenable,
    de modo que los requisitos adicionales muestran únicamente el botón de
    eliminar y la fila queda más limpia.
-->
<UserControl
    x:Class="GeneradorAnexos.WinUI.Controls.EditorVinetas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeneradorAnexos.WinUI.Controls"
    HorizontalAlignment="Stretch">

    <StackPanel Spacing="8">

        <TextBlock Text="{x:Bind Titulo, Mode=OneWay}"
                   Style="{StaticResource Ga.EtiquetaCampo}"
                   Visibility="{x:Bind MostrarTitulo, Mode=OneWay}" />

        <ItemsControl ItemsSource="{x:Bind Filas}" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="controls:FilaLista">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#x2022;"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource Ga.TextoTenue}" />

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource Ga.CajaTexto}"
                                 Text="{x:Bind Texto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind Marcador, Mode=OneWay}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource Ga.BotonIcono}"
                                Visibility="{x:Bind MostrarReordenar, Mode=OneWay}"
                                IsEnabled="{x:Bind PuedeSubir, Mode=OneWay}"
                                Click="AlSubir"
                                ToolTipService.ToolTip="Subir">
                            <controls:Icono Nombre="chevron-up" Tamano="14" />
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource Ga.BotonIcono}"
                                Visibility="{x:Bind MostrarReordenar, Mode=OneWay}"
                                IsEnabled="{x:Bind PuedeBajar, Mode=OneWay}"
                                Click="AlBajar"
                                ToolTipService.ToolTip="Bajar">
                            <controls:Icono Nombre="chevron-down" Tamano="14" />
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource Ga.BotonIconoEliminar}"
                                Click="AlEliminar"
                                ToolTipService.ToolTip="Eliminar">
                            <controls:Icono Nombre="trash" Tamano="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="Vacio"
                   Text="{x:Bind TextoVacio, Mode=OneWay}"
                   Style="{StaticResource Ga.MensajeAyuda}" />

        <TextBlock x:Name="Aviso"
                   Text="Agregue al menos un elemento."
                   Style="{StaticResource Ga.MensajeError}"
                   Visibility="Collapsed" />

        <Button Style="{StaticResource Ga.BotonSecundarioCompacto}"
                HorizontalAlignment="Left"
                Click="AlAgregar">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:Icono Nombre="plus" Tamano="14" Trazo="{ThemeResource Ga.Acento}" />
                <TextBlock Text="{x:Bind TextoBoton, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
