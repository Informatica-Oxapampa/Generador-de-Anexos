<!--
    Controls/CampoTexto.xaml
    ────────────────────────
    Campo de formulario de una línea.

    Estructura, de arriba abajo:
        icono + etiqueta  →  entrada  →  mensaje de ayuda, acierto o error

    El icono acompaña a la etiqueta y ya no se superpone dentro del cuadro de
    texto. Así el relleno de la entrada es el nativo de WinUI y el campo no se
    descuadra con el escalado de pantalla ni con el texto grande de Windows.
-->
<UserControl
    x:Class="GeneradorAnexos.WinUI.Controls.CampoTexto"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GeneradorAnexos.WinUI.Controls"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">

    <StackPanel Spacing="6">

        <!-- Etiqueta del campo (el asterisco lo añade el código si es obligatorio) -->
        <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icono x:Name="IconoLider"
                            Tamano="14"
                            Trazo="{ThemeResource Ga.TextoTenue}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
            <TextBlock x:Name="Etiqueta"
                       Style="{StaticResource Ga.EtiquetaCampo}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBox x:Name="Entrada"
                 Style="{StaticResource Ga.CajaTexto}"
                 TextChanged="AlCambiarTexto"
                 LostFocus="AlPerderFoco" />

        <!-- Mensaje: icono de acierto (solo en estado válido) + texto -->
        <Grid x:Name="FilaMensaje" ColumnSpacing="6" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:Icono x:Name="IconoOk"
                            Grid.Column="0"
                            Nombre="check"
                            Tamano="13"
                            Trazo="{ThemeResource Ga.Ok}"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0"
                            Visibility="Collapsed" />

            <TextBlock x:Name="Mensaje"
                       Grid.Column="1"
                       Style="{StaticResource Ga.MensajeAyuda}" />
        </Grid>
    </StackPanel>
</UserControl>
