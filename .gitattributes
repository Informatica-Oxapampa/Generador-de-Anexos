# Normalización de fin de línea: el repositorio guarda LF y Windows recibe CRLF.
* text=auto

# Los .docx son ZIP: tratarlos como binarios evita que Git los corrompa al
# intentar normalizarlos y evita diffs ilegibles.
*.docx binary
*.xlsx binary
*.pdf  binary
*.ico  binary
*.png  binary

# Los scripts de Windows necesitan CRLF para ejecutarse correctamente.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.iss  text eol=crlf
